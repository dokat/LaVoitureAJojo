# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase.
# VITE_SUPABASE_ANON_KEY accepte aussi bien l'ancienne clé « anon » (JWT
# eyJ…) que la nouvelle clé « publishable » (sb_publishable_…) — même rôle,
# publique par conception (D17).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx
